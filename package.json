{
  "name": "werkmeister-monorepo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Turborepo monorepo — sandbox CLI and werkmeister-dashboard app.",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build && changeset publish",
    "licenses": "node --test 'scripts/*.test.mjs' && node scripts/check-licenses.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
