{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "types": ["node"]
  },
  // A glob, not a list: an explicit one silently dropped `k8s.ts` and
  // `k8s_forwards.ts` from a build that still exited 0.
  "include": ["src/**/*.ts"]
}
