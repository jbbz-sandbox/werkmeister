{
  "name": "sandbox-core",
  "version": "0.13.0",
  "type": "module",
  "private": true,
  "description": "Shared sandbox library: config/registry resolution, workspace creation and lifecycle, and issue-tracker helpers. Consumed by the `sandbox` CLI itself, sandbox-dashboard, and the VS Code extension.",
  "main": "dist/sandbox.js",
  "types": "dist/sandbox.d.ts",
  "exports": {
    ".": "./dist/sandbox.js",
    "./agent_gen": "./dist/agent_gen.js",
    "./archetypes": "./dist/archetypes.js",
    "./browser": "./dist/browser.js",
    "./cache": "./dist/cache.js",
    "./caddy": "./dist/caddy.js",
    "./claude_md": "./dist/claude_md.js",
    "./colors": "./dist/colors.js",
    "./compose": "./dist/compose.js",
    "./compose_file": "./dist/compose_file.js",
    "./config": "./dist/config.js",
    "./docker": "./dist/docker.js",
    "./errors": "./dist/errors.js",
    "./feature_routing": "./dist/feature_routing.js",
    "./form_schema": "./dist/form_schema.js",
    "./fragment_detect": "./dist/fragment_detect/index.js",
    "./generate": "./dist/generate.js",
    "./gate": "./dist/gate.js",
    "./pr_guard": "./dist/pr_guard.js",
    "./pr_lifecycle": "./dist/pr_lifecycle.js",
    "./git_hooks": "./dist/git_hooks.js",
    "./global_config": "./dist/global_config.js",
    "./graduate": "./dist/graduate.js",
    "./hooks_gen": "./dist/hooks_gen.js",
    "./infra": "./dist/infra.js",
    "./issue_snapshot": "./dist/issue_snapshot.js",
    "./issue_tracker": "./dist/issue_tracker.js",
    "./k8s": "./dist/k8s.js",
    "./k8s_forwards": "./dist/k8s_forwards.js",
    "./lifecycle": "./dist/lifecycle.js",
    "./locks": "./dist/locks.js",
    "./machine_setup": "./dist/machine_setup.js",
    "./mcp_gen": "./dist/mcp_gen.js",
    "./notes": "./dist/notes.js",
    "./plugin_check": "./dist/plugin_check.js",
    "./proc": "./dist/proc.js",
    "./registry_sync": "./dist/registry_sync.js",
    "./reporter": "./dist/reporter.js",
    "./safari": "./dist/safari.js",
    "./scaffold": "./dist/scaffold.js",
    "./secrets": "./dist/secrets.js",
    "./skill_gen": "./dist/skill_gen.js",
    "./slots": "./dist/slots.js",
    "./stats": "./dist/stats.js",
    "./test_run": "./dist/test_run.js",
    "./standards": "./dist/standards.js",
    "./status": "./dist/status.js",
    "./strategies": "./dist/strategies/index.js",
    "./telepresence": "./dist/telepresence.js",
    "./web_servers": "./dist/web_servers.js",
    "./workspace_init": "./dist/workspace_init.js",
    "./workspace_prompts": "./dist/workspace_prompts.js",
    "./workspace_skills": "./dist/workspace_skills.js",
    "./worktrees": "./dist/worktrees.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test *.test.mjs && for f in *.smoke.mjs; do node \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/tar-fs": "^2.0.4",
    "ajv": "^8.20.0",
    "dockerode": "^5.0.1",
    "jsonc-parser": "^3.3.1",
    "nunjucks": "^3.2.4",
    "tar-fs": "^2.1.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^5.9.3"
  }
}
