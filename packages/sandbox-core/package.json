{
  "name": "sandbox-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Shared sandbox library: config/registry resolution, workspace + Jira helpers, and typed wrappers over the `sandbox` CLI. Consumed by the CLI itself, sandbox-dashboard, claudeck, and the VS Code extension.",
  "main": "dist/sandbox.js",
  "types": "dist/sandbox.d.ts",
  "exports": {
    ".": "./dist/sandbox.js",
    "./cache": "./dist/cache.js",
    "./colors": "./dist/colors.js",
    "./config": "./dist/config.js",
    "./detect": "./dist/detect.js",
    "./docker": "./dist/docker.js",
    "./global_config": "./dist/global_config.js",
    "./infra": "./dist/infra.js",
    "./k8s": "./dist/k8s.js",
    "./k8s_forwards": "./dist/k8s_forwards.js",
    "./locks": "./dist/locks.js",
    "./proc": "./dist/proc.js",
    "./reporter": "./dist/reporter.js",
    "./secrets": "./dist/secrets.js",
    "./slots": "./dist/slots.js",
    "./worktrees": "./dist/worktrees.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test *.test.mjs && for f in *.smoke.mjs; do node \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/tar-fs": "^2.0.4",
    "dockerode": "^5.0.1",
    "tar-fs": "^2.1.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
