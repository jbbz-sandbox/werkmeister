{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["sandbox.ts", "cache.ts", "colors.ts", "config.ts", "detect.ts", "docker.ts", "global_config.ts", "infra.ts", "jira-rest.ts", "k8s.ts", "k8s_forwards.ts", "locks.ts", "proc.ts", "reporter.ts", "secrets.ts", "slots.ts", "worktrees.ts"]
}
