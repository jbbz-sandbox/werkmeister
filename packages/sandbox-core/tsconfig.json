{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "types": ["node"]
  },
  // Explicit, not a glob: a module missing from this list is silently not
  // emitted, and `npm run build` still exits 0 — the failure only surfaces as
  // TS2307 in a consumer. Every migration step that moves a file here must add
  // it. (tsc reads JSONC, so this comment is fine.)
  "include": [
    "sandbox.ts",
    "archetypes.ts",
    "cache.ts",
    "caddy.ts",
    "colors.ts",
    "config.ts",
    "detect.ts",
    "docker.ts",
    "feature_routing.ts",
    "form_schema.ts",
    "global_config.ts",
    "infra.ts",
    "jira-rest.ts",
    "k8s.ts",
    "k8s_forwards.ts",
    "locks.ts",
    "proc.ts",
    "reporter.ts",
    "scaffold.ts",
    "secrets.ts",
    "slots.ts",
    "worktrees.ts"
  ]
}
