{
  "name": "werkmeister-ui",
  "version": "0.5.42",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "description": "The UI modules apps/werkmeister-dashboard and apps/werkmeister-mcp share, and the non-DOM workspace display model every surface reads.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc && cp src/tokens.css dist/ && cp -R src/fonts dist/",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.mjs"
  },
  "dependencies": {
    "@rjsf/core": "^5.24.0",
    "@rjsf/utils": "^5.24.0",
    "@rjsf/validator-ajv8": "^5.24.0",
    "markdown-it": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "werkmeister-core": "workspace:*"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
