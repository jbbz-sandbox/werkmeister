{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // SW-361: esbuild.mjs bakes HEAD and the dirty flag into the CLI, and neither is
    // an input, so a replay carries a stale stamp. The bundle takes under a second.
    "werkmeister#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // SW-753: `tsc --noEmit` reuses the build's tsbuildinfo, so it runs after the build instead of checking the same program beside it.
    "werkmeister-core#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["WERKMEISTER_FEATURE", "SANDBOX_FEATURE", "TMPDIR"]
    },
    // SW-405: a measurement, so never replayed: a cached run would re-report an old duration and ledger rows.
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["WERKMEISTER_FEATURE", "SANDBOX_FEATURE", "TMPDIR"],
      "cache": false
    },
    // The merged monorepo summary, after every package's report.
    "//#test:coverage": {
      "dependsOn": [
        "werkmeister#test:coverage",
        "werkmeister-core#test:coverage",
        "werkmeister-mcp#test:coverage",
        "werkmeister-ui#test:coverage",
        "werkmeister-vscode#test:coverage",
        "docs-site#test:coverage",
        "werkmeister-dashboard#test:coverage"
      ],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
