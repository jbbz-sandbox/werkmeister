{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["WERKMEISTER_FEATURE", "SANDBOX_FEATURE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
