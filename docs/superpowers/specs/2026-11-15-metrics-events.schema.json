{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "werkmeister/metrics-event/v1",
  "title": "werkmeister metrics event (one line of ~/.werkmeister/metrics/events-YYYY-MM.jsonl)",
  "description": "Proposed in SW-772. Append-only, one JSON object per line, one appendFileSync (a single write() on an O_APPEND file) per line so concurrent writers don't interleave; lines stay under 4096 bytes as a sanity cap. Never leaves the machine. The examples are illustrative shapes, not recorded data.",
  "type": "object",
  "required": ["v", "at", "event"],
  "properties": {
    "v": { "const": 1 },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When the event happened, UTC ISO 8601"
    },
    "event": {
      "enum": [
        "queue.wait",
        "queue.admit",
        "queue.preempt",
        "ask",
        "answer",
        "stage.done",
        "issue.start",
        "gate.start",
        "gate.end",
        "pr.open",
        "pr.merged",
        "release",
        "coverage",
        "workspace.create",
        "workspace.init",
        "workspace.up",
        "workspace.down",
        "workspace.pause",
        "workspace.resume",
        "workspace.close",
        "workspace.abandon",
        "gate.row",
        "call.slow"
      ]
    },
    "result": {
      "enum": ["ok", "error"],
      "description": "workspace.*, gate.row, call.slow: whether the timed step succeeded (SW-404)"
    },
    "row": { "type": "string", "description": "gate.row: the gate row's name (SW-404)" },
    "cmd": {
      "enum": ["docker build", "install", "git fetch", "tracker"],
      "description": "call.slow: which external call took 5 s or more (SW-404)"
    },
    "workspace": {
      "type": "string",
      "description": "Workspace folder name, e.g. sw-753-incremental-tsc"
    },
    "run_id": {
      "type": "string",
      "description": "The writing workspace run's id, `run_id` in its workspace.yml (SW-1140); absent on lines written before it. Same-named runs' lines are told apart by it"
    },
    "ticket": { "type": "string", "description": "Tracker key, e.g. SW-753" },
    "session": { "type": "string", "description": "Claude session id (ask, answer)" },
    "version": {
      "type": "string",
      "description": "werkmeister version+commit that wrote the line, e.g. 0.91.3+1dbfac70"
    },
    "feature": {
      "type": "string",
      "description": "queue.wait, queue.admit: the feature asking for capacity; queue.preempt: the feature stopped"
    },
    "reason": {
      "enum": ["waiting for capacity", "preempted", "requeued"],
      "description": "queue.wait: which writer queued it (SW-991)"
    },
    "rank": {
      "enum": ["idle", "human-check", "working", "person"],
      "description": "queue.preempt: how admission ranked the stopped feature"
    },
    "for": { "type": "string", "description": "queue.preempt: the feature it made room for" },
    "position": {
      "type": "integer",
      "minimum": 1,
      "description": "queue.wait: place in the queue"
    },
    "waited_s": {
      "type": "integer",
      "minimum": 0,
      "description": "queue.admit: seconds since the matching queue.wait; answer: seconds since the matching ask"
    },
    "kind": {
      "enum": ["question", "plan", "permission", "wrap-up"],
      "description": "ask: what the person is asked for"
    },
    "stage": {
      "type": "string",
      "pattern": "^\\d{2}_[a-z_]+$",
      "description": "stage.done: the stage whose output was committed"
    },
    "commit": {
      "type": "string",
      "description": "stage.done: record-branch commit that first filled output/; coverage: the measured commit"
    },
    "run": {
      "type": "string",
      "description": "gate.*: id shared by a gate.start and its gate.end; coverage: the gate run or CI run id"
    },
    "exit": {
      "type": "integer",
      "description": "gate.end: exit code; 75 = retry later (host load)"
    },
    "retry": {
      "type": "integer",
      "minimum": 0,
      "description": "gate.start: 0 for the first run of this PR's gate in this workspace, n for the nth rerun"
    },
    "pr": { "type": "string", "format": "uri", "description": "pr.*, release: the PR URL" },
    "tag": { "type": "string", "description": "release: the release tag" },
    "source": {
      "enum": ["ci-main", "ci-pr", "gate"],
      "description": "coverage: where the run happened; merge-queue runs count as ci-main (SW-405)"
    },
    "package": { "type": "string", "description": "coverage: the measured package name" },
    "lines": { "type": "number", "minimum": 0, "maximum": 100, "description": "coverage: lines %" },
    "branches": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "coverage: branches %"
    },
    "functions": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "coverage: functions %"
    },
    "statements": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "coverage: statements %"
    },
    "tests": { "type": "integer", "minimum": 0, "description": "coverage: tests the run counted" },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "coverage: wall time of the test command; workspace.*, gate.row, call.slow: wall time of the step (SW-404)"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "event": { "not": { "const": "coverage" } } } },
      "then": { "required": ["workspace"] }
    },
    {
      "if": { "properties": { "event": { "const": "coverage" } } },
      "then": {
        "required": ["source", "commit", "package", "lines", "branches", "functions", "statements"]
      }
    },
    {
      "if": { "properties": { "event": { "const": "queue.wait" } } },
      "then": { "required": ["feature", "position"] }
    },
    {
      "if": { "properties": { "event": { "const": "queue.admit" } } },
      "then": { "required": ["feature", "waited_s"] }
    },
    {
      "if": { "properties": { "event": { "const": "queue.preempt" } } },
      "then": { "required": ["feature", "rank", "for"] }
    },
    {
      "if": { "properties": { "event": { "const": "ask" } } },
      "then": { "required": ["session", "kind"] }
    },
    {
      "if": { "properties": { "event": { "const": "answer" } } },
      "then": { "required": ["session", "waited_s"] }
    },
    {
      "if": { "properties": { "event": { "const": "stage.done" } } },
      "then": { "required": ["stage", "commit"] }
    },
    {
      "if": { "properties": { "event": { "const": "issue.start" } } },
      "then": { "required": ["ticket"] }
    },
    {
      "if": { "properties": { "event": { "const": "gate.start" } } },
      "then": { "required": ["run", "retry"] }
    },
    {
      "if": { "properties": { "event": { "const": "gate.end" } } },
      "then": { "required": ["run", "exit"] }
    },
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "workspace.create",
              "workspace.init",
              "workspace.up",
              "workspace.down",
              "workspace.pause",
              "workspace.resume",
              "workspace.close",
              "workspace.abandon"
            ]
          }
        }
      },
      "then": { "required": ["duration_ms", "result"] }
    },
    {
      "if": { "properties": { "event": { "const": "gate.row" } } },
      "then": { "required": ["run", "row", "duration_ms", "result"] }
    },
    {
      "if": { "properties": { "event": { "const": "call.slow" } } },
      "then": { "required": ["cmd", "duration_ms", "result"] }
    },
    {
      "if": { "properties": { "event": { "enum": ["pr.open", "pr.merged"] } } },
      "then": { "required": ["pr"] }
    },
    {
      "if": { "properties": { "event": { "const": "release" } } },
      "then": { "required": ["pr", "tag"] }
    }
  ],
  "examples": [
    {
      "v": 1,
      "at": "2026-11-15T06:05:40Z",
      "event": "queue.wait",
      "workspace": "sw-755-up-timeout-setting",
      "feature": "sw-755-up-timeout-setting",
      "position": 1
    },
    {
      "v": 1,
      "at": "2026-11-15T06:51:10Z",
      "event": "queue.admit",
      "workspace": "sw-755-up-timeout-setting",
      "feature": "sw-755-up-timeout-setting",
      "waited_s": 2730
    },
    {
      "v": 1,
      "at": "2026-11-15T07:00:00Z",
      "event": "ask",
      "workspace": "sw-753-incremental-tsc",
      "ticket": "SW-753",
      "session": "70c75897-dca2-4bf6-8e4f-9e9452f903a0",
      "kind": "question"
    },
    {
      "v": 1,
      "at": "2026-11-15T07:06:25Z",
      "event": "answer",
      "workspace": "sw-753-incremental-tsc",
      "ticket": "SW-753",
      "session": "70c75897-dca2-4bf6-8e4f-9e9452f903a0",
      "waited_s": 385
    },
    {
      "v": 1,
      "at": "2026-11-15T06:14:12Z",
      "event": "stage.done",
      "workspace": "sw-753-incremental-tsc",
      "ticket": "SW-753",
      "stage": "02_spec",
      "commit": "a1b2c3d"
    },
    {
      "v": 1,
      "at": "2026-11-15T06:01:30Z",
      "event": "issue.start",
      "workspace": "sw-753-incremental-tsc",
      "ticket": "SW-753"
    },
    {
      "v": 1,
      "at": "2026-11-15T07:20:00Z",
      "event": "gate.start",
      "workspace": "sw-753-incremental-tsc",
      "run": "g1",
      "retry": 0,
      "version": "0.91.0+eb91a575"
    },
    {
      "v": 1,
      "at": "2026-11-15T07:31:58Z",
      "event": "gate.end",
      "workspace": "sw-753-incremental-tsc",
      "run": "g1",
      "exit": 0
    },
    {
      "v": 1,
      "at": "2026-11-15T07:25:10Z",
      "event": "gate.row",
      "workspace": "sw-753-incremental-tsc",
      "run": "g1",
      "row": "werkmeister-core",
      "duration_ms": 312000,
      "result": "ok"
    },
    {
      "v": 1,
      "at": "2026-11-15T07:05:00Z",
      "event": "workspace.up",
      "workspace": "sw-753-incremental-tsc",
      "duration_ms": 48200,
      "result": "ok"
    },
    {
      "v": 1,
      "at": "2026-11-15T07:04:12Z",
      "event": "call.slow",
      "workspace": "sw-753-incremental-tsc",
      "cmd": "install",
      "duration_ms": 21400,
      "result": "ok"
    },
    {
      "v": 1,
      "at": "2026-11-15T15:34:09Z",
      "event": "pr.open",
      "workspace": "sw-753-incremental-tsc",
      "ticket": "SW-753",
      "pr": "https://github.com/jbbz-sandbox/werkmeister/pull/871"
    },
    {
      "v": 1,
      "at": "2026-11-15T15:42:29Z",
      "event": "pr.merged",
      "workspace": "sw-753-incremental-tsc",
      "ticket": "SW-753",
      "pr": "https://github.com/jbbz-sandbox/werkmeister/pull/871"
    },
    {
      "v": 1,
      "at": "2026-11-16T09:00:00Z",
      "event": "release",
      "workspace": "sw-753-incremental-tsc",
      "pr": "https://github.com/jbbz-sandbox/werkmeister/pull/871",
      "tag": "werkmeister@0.91.4"
    },
    {
      "v": 1,
      "at": "2026-11-24T10:00:00Z",
      "event": "coverage",
      "source": "ci-pr",
      "commit": "d7b749c0",
      "run": "45208589128",
      "package": "werkmeister-core",
      "version": "0.9.100+d7b749c0",
      "lines": 54.8,
      "branches": 52.82,
      "functions": 34.15,
      "statements": 54.8,
      "tests": 1715,
      "duration_ms": 121000
    }
  ]
}
