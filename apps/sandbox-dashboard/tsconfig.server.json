{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "types": ["node"]
  },
  // The server entries only: the rest of src/ is the DOM UI, which vite bundles.
  "include": ["src/server.ts", "src/main.ts", "src/form-cli.ts", "src/lib"]
}
