{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    // c8 maps coverage back to src/*.ts through these (SW-405).
    "sourceMap": true,
    "incremental": true,
    // Inside dist/: same reasoning as packages/werkmeister-core/tsconfig.json.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  // A glob, not a list — same reasoning as packages/werkmeister-core/tsconfig.json.
  "include": ["src/**/*.ts"]
}
