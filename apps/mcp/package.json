{
  "name": "werkmeister-mcp",
  "version": "0.3.7",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "description": "The werkmeister MCP server: every tool, over stdio and authenticated HTTP, including the MCP App UI tools.",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve:stdio": "node dist/main.js --stdio",
    "serve:http": "node dist/main.js",
    "test": "tsc && node --test *.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "werkmeister-core": "^0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
