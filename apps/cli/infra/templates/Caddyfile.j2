# ---------------------------------------------------------------------------
# Host routers. Caddy terminates each service's public hostname directly and reverse-proxies to its upstream
# (a local feature container via host.docker.internal:<port>, or a remote K8s
# Service). When an X-Feature cookie is present, its value is copied into an
# X-Feature header on the upstream call so the app can read the selected feature.
# ---------------------------------------------------------------------------
{% for r in host_routers %}
# {{ r.service }}
{{ r.hostname }} {
    tls internal

    # Sandbox feature selector: a static picker UI (mounted at /sandbox/proxy/ui)
    # that sets/clears the X-Feature cookie client-side. Served on every host so
    # `https://<host>/__sandbox` works. features.json is matched first (it's a
    # real file); any other /__sandbox path returns the picker.
    handle /__sandbox/features.json {
        root * /sandbox/proxy/ui
        rewrite * /features.json
        file_server
    }
    handle /__sandbox* {
        root * /sandbox/proxy/ui
        rewrite * /index.html
        file_server
    }

    # Cookie present -> copy its value into an X-Feature header, then proxy.
    @xf header_regexp xf Cookie X-Feature=([^;]+)
    handle @xf {
        reverse_proxy {{ r.upstream }} {
            header_up X-Feature {re.xf.1}
        }
    }
    # No cookie -> route anyway, without the header.
    handle {
        reverse_proxy {{ r.upstream }}
    }
}
{% endfor %}
