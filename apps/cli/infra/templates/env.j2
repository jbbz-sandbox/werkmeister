# Auto-generated environment for feature: {{ feature_name }}
# Slot: {{ slot }} | Port range: {{ base_port }}-{{ base_port + 19 }}
# WARNING: this file may contain secret values merged from ~/.sandbox/secrets.env — never commit it.

# Feature identification (consumed by container code and Playwright tests via
# process.env.SANDBOX_FEATURE — see cli/commands/test.py). The FEATURE key in
# the workspace metadata block above carries the same value but a different
# audience: `sandbox up` and humans inspecting the file. Both intentional.
SANDBOX_FEATURE={{ feature_name }}
SANDBOX_SLOT={{ slot }}
COMPOSE_PROJECT_NAME=sandbox-{{ feature_name }}

# Service URLs. Each service gets <PREFIX>_URL / _HOST / _PORT: a local sibling
# in this feature resolves to its docker DNS alias (http://<svc>:<port>), any
# other service to the k8s port-forward (http://k8s-forwards:<forward_port>).
# Keys that collide with a local service's docker-compose `environment:` override
# are auto-renamed to *_BASE_URL / *_BASE_HOST / *_BASE_PORT (compose
# `environment:` always wins over `env_file: .env`).
{% for key, value in service_urls.items() | sort %}
{{ key }}={{ value }}
{% endfor %}

# Secret values merged from ~/.sandbox/secrets.env, narrowed to the keys the
# local services declare via services.yaml `secrets:`. Never commit this file.
{% for key, value in secrets.items() | sort %}
{{ key }}={{ value }}
{% endfor %}

# Additional per-workspace environment variables (.sandbox/workspace.yml
# `env_vars:`). Rendered last, so these win over a service URL or secret above.
{% for key, value in env_vars.items() | sort %}
{{ key }}={{ value }}
{% endfor %}
