# Auto-generated environment for feature: {{ feature_name }}
# Slot: {{ slot }} | Port range: {{ base_port }}-{{ base_port + 19 }}
# Secrets are not here: each service gets its own .env.<service> (from
# ~/.werkmeister/secrets.env, `<SERVICE>__KEY` or plain `KEY`) as a second env_file.

# Feature identification, read by container code and Playwright tests. The FEATURE
# key in the metadata block above carries the same value for `werkmeister up` and
# humans. SANDBOX_FEATURE is the pre-rename name, exported until suites read
# WERKMEISTER_FEATURE (SW-106).
WERKMEISTER_FEATURE={{ feature_name }}
SANDBOX_FEATURE={{ feature_name }}
WERKMEISTER_SLOT={{ slot }}
COMPOSE_PROJECT_NAME=werkmeister-{{ feature_name }}

# Service URLs. Each service gets <PREFIX>_URL / _HOST / _PORT: a local sibling
# in this feature resolves to its docker DNS alias (http://<svc>:<port>), any
# other service to its services.yaml baseline_upstream when set, else to the
# k8s port-forward (http://k8s-forwards:<forward_port>).
# Keys that collide with a local service's docker-compose `environment:` override
# are auto-renamed to *_BASE_URL / *_BASE_HOST / *_BASE_PORT (compose
# `environment:` always wins over `env_file: .env`).
{% for key, value in service_urls.items() | sort %}
{{ key }}={{ value }}
{% endfor %}

# Additional per-workspace environment variables (.werkmeister/workspace.yml
# `env_vars:`). Rendered last, so these win over a service URL above; they
# also override a same-named secret in each service's .env.<service>.
{% for key, value in env_vars.items() | sort %}
{{ key }}={{ value }}
{% endfor %}
