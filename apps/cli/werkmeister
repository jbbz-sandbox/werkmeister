#!/bin/bash
# werkmeister CLI (alias w9r; deprecated alias sandbox) - Multi-feature concurrent development orchestrator
# TypeScript port: the wrapper only resolves SANDBOX_ROOT + node and execs dist/main.js.
set -euo pipefail

# Load machine-global config exports (generated by `sandbox config` from
# ~/.sandbox/config.yaml) so the CLI inherits SANDBOX_* without a per-client env block.
# ~/.werkmeister wins when it exists, else ~/.sandbox (SW-7), same as werkmeister-core's dotDir.
for d in .werkmeister .sandbox; do
    if [ -d "$HOME/$d" ]; then
        [ -f "$HOME/$d/env.sh" ] && . "$HOME/$d/env.sh"
        break
    fi
done

# The running checkout is authoritative for SANDBOX_ROOT — re-derive and export
# AFTER sourcing env.sh so a stale value there can never win.
SANDBOX_ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export SANDBOX_ROOT
# WERKMEISTER_ROOT is read first, so it must carry the authoritative value too.
export WERKMEISTER_ROOT="$SANDBOX_ROOT"

# Running out of npx's cache (`npx werkmeister setup`) — install
# globally and hand off, rather than running from here.
#
# SANDBOX_ROOT above resolved to ~/.npm/_npx/<hash>/..., which npm garbage-
# collects and re-hashes on every version change. `setup` and `config` persist
# that path into ~/.sandbox/config.yaml and env.sh, and the compose generator
# bakes it into every workspace's compose.yml as a bind mount, so running
# from the cache pins permanent state to a directory that is going to vanish.
# Bootstrapping is the one thing npx is right for here: install, then exec the
# stable copy. The re-exec cannot loop — the global path has no _npx in it.
case "$SANDBOX_ROOT" in
  */_npx/*)
    # Install the exact version npx resolved, not @latest: `npx pkg@1.2.3 setup`
    # must not silently onboard the machine onto a different release.
    pkg="$(node -p "const p=require('$SANDBOX_ROOT/package.json'); p.name + '@' + p.version" 2>/dev/null || echo "werkmeister")"
    echo "Bootstrapping: installing $pkg globally (npx's cache is not a stable install location)..." >&2
    if ! npm install -g "$pkg" >&2; then
        echo "Error: global install failed. Install it yourself, then re-run:" >&2
        echo "  npm install -g $pkg && werkmeister $*" >&2
        exit 1
    fi
    global_bin="$(npm prefix -g)/bin/werkmeister"
    if [ ! -x "$global_bin" ]; then
        echo "Error: installed $pkg but found no werkmeister binary at $global_bin." >&2
        exit 1
    fi
    echo "Installed. Continuing as $global_bin" >&2
    exec "$global_bin" "$@"
    ;;
esac

entry="$SANDBOX_ROOT/dist/main.js"
if [ ! -f "$entry" ]; then
    echo "Error: CLI not built — missing $entry (run 'npm install && npm run build')." >&2
    exit 1
fi

# Resolution order: $WERKMEISTER_NODE → $SANDBOX_NODE → node on PATH → newest nvm install.
node_bin="${WERKMEISTER_NODE:-${SANDBOX_NODE:-}}"
if [ -z "$node_bin" ] && command -v node >/dev/null 2>&1; then
    node_bin="$(command -v node)"
fi
if [ -z "$node_bin" ]; then
    nvm_root="${NVM_DIR:-$HOME/.nvm}/versions/node"
    newest="$(ls -d "$nvm_root"/v* 2>/dev/null | sort -V | tail -1 || true)"
    [ -n "$newest" ] && node_bin="$newest/bin/node"
fi
if [ -z "$node_bin" ] || [ ! -x "$node_bin" ]; then
    echo "Error: could not locate a node runtime. Set SANDBOX_NODE=/path/to/node." >&2
    exit 1
fi

# `dashboard` and `mcp` are sibling apps, not CLI subcommands: each has its own
# dist/main.js. Both are launched here over stdio, which is what an MCP client
# (Claude Desktop, the werkmeister plugin) needs -- their HTTP modes are
# started by `sandbox connect` as managed WebApps, which execs those same
# entrypoints directly without --stdio. That is why neither verb takes a
# transport flag; extra args are still forwarded, so an explicit --stdio from an
# older .mcp.json stays harmless.
#
# Only apps/cli is published to npm (see its package.json `files`), so on a
# global install these siblings are absent. apps/mcp is bundled into this
# package as dist/mcp.js (esbuild.mjs), so `mcp` always has a target. The
# dashboard (Jira, PRs, MCP Apps UI) is checkout-only; where it is missing its
# verb falls back to the headless server, which carries the same sandbox-*
# verbs, so the werkmeister plugin's `w9r dashboard` MCP entry keeps
# working on a package install instead of failing at every session start.
case "${1:-}" in
    dashboard) app_dir="sandbox-dashboard" ;;
    mcp)       app_dir="mcp" ;;
    *)         app_dir="" ;;
esac
if [ -n "$app_dir" ]; then
    app_entry="$(cd "$SANDBOX_ROOT/.." && pwd)/$app_dir/dist/main.js"
    bundled="$SANDBOX_ROOT/dist/mcp.js"
    if [ ! -f "$app_entry" ]; then
        if [ ! -f "$bundled" ]; then
            echo "Error: '$1' is not available -- missing $app_entry and $bundled (run 'npm run build')." >&2
            exit 1
        fi
        if [ "$1" = dashboard ]; then
            echo "sandbox dashboard: the workspaces dashboard ships with the checkout only; serving the headless MCP server ($bundled) instead." >&2
        fi
        app_entry="$bundled"
    fi
    shift
    exec "$node_bin" "$app_entry" --stdio "$@"
fi

# `hooks gate` is the PreToolUse standards gate — it fires on every Edit/Write,
# so it skips the commander/yaml import chain via a dedicated entrypoint.
if [ "${1:-}" = "hooks" ] && [ "${2:-}" = "gate" ]; then
    exec "$node_bin" "$SANDBOX_ROOT/dist/lib/gate.js"
fi
# `hooks pr-guard` fires on every Bash call in every workspace — same reason.
if [ "${1:-}" = "hooks" ] && [ "${2:-}" = "pr-guard" ]; then
    exec "$node_bin" "$SANDBOX_ROOT/dist/lib/pr_guard.js"
fi

exec "$node_bin" "$entry" "$@"
