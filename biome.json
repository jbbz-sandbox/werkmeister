{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.vscode-test",
      "!**/*.snapshot.json",
      "!apps/cli/infra/compose/scripts/otel-init.bundle.js",
      "!apps/sandbox-dashboard/workspace-list.artifact.html"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "suspicious": { "noAssignInExpressions": "off", "noImplicitAnyLet": "off" }
    }
  }
}
