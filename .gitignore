node_modules/
dist/
.next/
.turbo/
**/.vitepress/cache/
*.timestamp-*.mjs
*.log
.DS_Store

# Generated by older CLI versions into the checkout; current versions write
# under ~/.werkmeister/infra instead. Kept so a pre-move checkout stays clean.
apps/cli/infra/proxy/Caddyfile
apps/cli/infra/proxy/ui/features.json
apps/cli/infra/compose/k8s-port-forward/tmp/

# Per-workspace state (notes, handoffs, standards.json) — not source
.werkmeister/*
!.werkmeister/services.yaml
.sandbox/*
!.sandbox/services.yaml

# Generated per-workspace env — carries merged values from ~/.werkmeister/secrets.env
.env

# Python bytecode
__pycache__/
*.pyc
