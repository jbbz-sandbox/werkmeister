{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.vscode-test",
      "!**/*.snapshot.json",
      "!apps/cli/infra/compose/scripts/otel-init.bundle.js",
      "!apps/sandbox-dashboard/workspace-list.artifact.html",
      // Design references exported from Claude Design; rebuilt in packages/sandbox-ui, never imported
      "!docs/design"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "error" },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        // The hits are deliberate docker-compose `${VAR}` strings (e.g.
        // `${SANDBOX_STATE_DIR}/proxy/Caddyfile`), interpolated by compose, not JS.
        "noTemplateCurlyInString": "off"
      }
    }
  }
}
