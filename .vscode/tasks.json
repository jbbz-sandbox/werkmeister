{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build vscode-plugin",
      "type": "shell",
      "command": "npm run build -w vscode-plugin"
    },
    {
      "label": "watch vscode-plugin",
      "type": "shell",
      "command": "npm run watch -w vscode-plugin",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "pattern": {
          "regexp": "^✘ \\[ERROR\\] (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    }
  ]
}
