{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build werkmeister-vscode",
      "type": "shell",
      "command": "pnpm --filter werkmeister-vscode run build"
    },
    {
      // F5's debugger attach can fail (ECONNREFUSED ::1), leaving the dev host
      // waiting forever on debugBrk. This opens one with no debugger to attach.
      "label": "run werkmeister-vscode (no debugger)",
      "type": "shell",
      "command": "code --new-window --extensionDevelopmentPath=\"${workspaceFolder}/packages/werkmeister-vscode\" \"${workspaceFolder}\"",
      "dependsOn": "build werkmeister-vscode",
      "problemMatcher": []
    },
    {
      "label": "watch werkmeister-vscode",
      "type": "shell",
      "command": "pnpm --filter werkmeister-vscode run watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "pattern": {
          "regexp": "^✘ \\[ERROR\\] (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    }
  ]
}
