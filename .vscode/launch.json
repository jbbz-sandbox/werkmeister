{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Sandbox Workspaces Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/werkmeister-vscode"],
      "outFiles": ["${workspaceFolder}/packages/werkmeister-vscode/dist/**/*.cjs"],
      "preLaunchTask": "build werkmeister-vscode"
    },
    {
      "name": "Run Sandbox Workspaces Extension (watch)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/werkmeister-vscode"],
      "outFiles": ["${workspaceFolder}/packages/werkmeister-vscode/dist/**/*.cjs"],
      "preLaunchTask": "watch werkmeister-vscode"
    }
  ]
}
